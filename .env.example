# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_REPLY_MODE=thread  # 'thread' (channel comments via discussion group) or 'reply' (direct feed reply)

# Whitelist Targets (BTC, ETH, SOL)
COINS_WHITELIST=BTC,ETH,SOL

# Screener Interval & Ranking Settings
SCAN_INTERVAL_MINUTES=5
TOP_N_ALERTS=10

# Market Data Provider Configuration
# Options: binance, binance_spot, hyperliquid, oanda, ccxt (or ccxt_<exchange>)
DATA_PROVIDER=binance
FALLBACK_DATA_PROVIDER=hyperliquid

# CCXT Configuration (used when DATA_PROVIDER=ccxt)
# Supported exchanges: binance, bybit, okx, hyperliquid, gateio, kraken, etc.
CCXT_EXCHANGE=binance

# Hyperliquid API Settings (Gentle rate-limiting)
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_RPS=3.0

# Strategy Timeframes & Lookback
HTF_TIMEFRAME=4h
LTF_TIMEFRAME=5m
EXTREME_LTF_TIMEFRAME=5m
LOOKBACK_CANDLES=50
MAX_HTF_RETRACE_CANDLES=18
USE_CLOSE_BASED_INVALIDATION=false
SESSION_FILTER_ENABLED=false

# Strategy Enablement (true / false)
ENABLE_STRATEGY_1=false
ENABLE_STRATEGY_2=true

# Application Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
